     "minLength": 1,
     "privacy": "internal",
     "title": "Provider",
     "type": "string"
    },
    "account_key": {
     "minLength": 1,
     "privacy": "sensitive",
     "title": "Account Key",
     "type": "string"
    }
   },
   "required": [
    "provider",
    "account_key"
   ],
   "title": "AccountRef",
   "type": "object"
  },
  "Band": {
   "additionalProperties": false,
   "properties": {
    "lo": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
       "type": "string"
      }
     ],
     "privacy": "internal",
     "title": "Lo"
    },
    "hi": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
       "type": "string"
      }
     ],
     "privacy": "internal",
     "title": "Hi"
    }
   },
   "required": [
    "lo",
    "hi"
   ],
   "title": "Band",
   "type": "object"
  },
  "EstimatorRef": {
